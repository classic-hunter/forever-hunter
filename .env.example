# Required
DISCORD_TOKEN=put_your_bot_token_here

# Recommended while testing.
# Commands sync directly to this server and appear quickly.
DISCORD_GUILD_ID=

# GitHub Wiki repository + browser URL
WIKI_GIT_URL=https://github.com/classic-hunter/forever-hunter.wiki.git
WIKI_WEB_BASE=https://github.com/classic-hunter/forever-hunter/wiki

# Local clone/cache folder
WIKI_DIR=wiki-cache

# Channel used for the live FAQ dashboard
DISCORD_FAQ_CHANNEL_ID=

# Optional: separate channel for live Hunter bug panel. Leave blank to use FAQ channel.
DISCORD_BUG_CHANNEL_ID=

HUNTER_BUG_DATA_URL=https://raw.githubusercontent.com/classic-hunter/forever-hunter/master/data/hunter-bugs.json
